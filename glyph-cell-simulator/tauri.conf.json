{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glyph-cell simulator",
  "version": "0.1.0",
  "identifier": "io.github.glyphcell.simulator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "glyph-cell simulator",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
